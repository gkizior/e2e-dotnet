<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>E2E.XUnit.V3</RootNamespace>
    <AssemblyName>E2E.XUnit.V3</AssemblyName>
    <PackageId>E2E.XUnit.V3</PackageId>
    <Description>xUnit v3 fixture for the E2E .NET port. Each test gets an engine session, and the replay cache commits from the xUnit result.</Description>
    <PackageTags>e2e;testing;xunit;agent</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\E2E\E2E.csproj" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="1.0.1" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
