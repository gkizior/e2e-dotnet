<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>E2E.Cli</RootNamespace>
    <AssemblyName>E2E.Cli</AssemblyName>
    <PackageId>E2E.Cli</PackageId>
    <Description>dotnet tool that runs E2E test assemblies. Command name: e2e.</Description>
    <PackageTags>e2e;testing;cli</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>e2e</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Playwright copies .ps1 helpers into the tool output. They are not NuGet install scripts. -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\E2E\E2E.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
